{
  "manifest_version": 3,
  "name": "标签页录制",
  "version": "1.3.0",
  "description": "录制当前页面正在播放的画面和声音。请仅用于你有权保存的内容，并遵守著作权法和网站条款。",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html",
    "default_title": "标签页录制",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "offscreen",
    "downloads",
    "alarms",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
